<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;

class ChecklistProgress extends Model
{
    use HasFactory;

    protected $fillable = [
        'checklist_submission_id',
        'current_step',
        'completed_steps',
        'draft_data',
        'last_saved_at',
        'is_draft'
    ];

    protected $casts = [
        'completed_steps' => 'array',
        'draft_data' => 'array',
        'last_saved_at' => 'datetime',
    ];

    public function checklistSubmission()
    {
        return $this->belongsTo(ChecklistSubmission::class);
    }

    public function markStepCompleted($step)
    {
        $completed = $this->completed_steps ?? [];
        if (!in_array($step, $completed)) {
            $completed[] = $step;
            $this->completed_steps = $completed;
        }
    }

    public function isStepCompleted($step)
    {
        return in_array($step, $this->completed_steps ?? []);
    }

    public function getProgressPercentage()
    {
        $totalSteps = 8; // Based on the 8 standards in medical specialist checklist
        $completed = count($this->completed_steps ?? []);
        return round(($completed / $totalSteps) * 100);
    }
}
